---
const {title,description='Independent crash data, research and practical resources.'}=Astro.props;
const nav=[['Research','/research/'],['Arizona','/arizona/'],['After a crash','/resources/'],['Find an attorney','/attorneys/'],['Media','/media/']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Car Crash Plus</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/></head><body><header><div class="wrap nav"><a class="brand" href="/">car crash<span>+</span></a><nav aria-label="Main navigation">{nav.map(([label,url])=><a href={url} aria-current={Astro.url.pathname===url?'page':undefined}>{label}</a>)}</nav></div></header><main><slot/></main><footer><div class="wrap"><a class="brand" href="/">car crash<span>+</span></a><p>Independent road safety research and accident information. Not a government agency or law firm.</p><a href="/about/">About & editorial standards</a> · <a href="/media/">Media inquiries</a><p>Information only, not individualized legal or medical advice.</p></div></footer></body></html>
<style is:global>
:root{font-family:system-ui,sans-serif;color:#192b32;background:#faf9f5;line-height:1.6;--ink:#14363f;--accent:#ae471e;--line:#d9dfdb}*{box-sizing:border-box}body{margin:0}a{color:#13576a;text-underline-offset:4px}a:hover{color:var(--accent)}.wrap{max-width:1160px;margin:auto;padding:0 28px}header{background:#fff;border-bottom:1px solid var(--line)}.nav{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:80px}.brand{font-weight:850;letter-spacing:-.075em;font-size:32px;text-decoration:none;color:var(--ink);white-space:nowrap}.brand span{color:var(--accent)}nav{display:flex;flex-wrap:wrap;gap:20px}nav a{text-decoration:none;font-weight:650;font-size:14px}nav a[aria-current]{text-decoration:underline}h1,h2,h3{line-height:1.15;letter-spacing:-.035em;color:var(--ink)}h1{font-size:clamp(38px,5.8vw,76px);margin:12px 0 22px}h2{font-size:32px}h3{font-size:22px}p{max-width:75ch}.hero{background:#14363f;color:white;padding:70px 0}.hero h1,.hero h2{color:white}.hero p{color:#dce8e6;font-size:19px}.hero-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:60px;align-items:center}.eyebrow{text-transform:uppercase;font-size:12px;letter-spacing:.15em;font-weight:800;color:var(--accent)}.hero .eyebrow{color:#ffb58c}.button{display:inline-block;background:#f1c099;color:#17343b;padding:12px 20px;text-decoration:none;font-weight:750;border-radius:3px}.section{padding:48px 0;border-bottom:1px solid var(--line)}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.tile{background:#fff;border:1px solid var(--line);padding:24px;border-top:3px solid #477d80}.tile h3{margin-top:0}.stat{font-size:clamp(32px,4vw,52px);font-weight:800;letter-spacing:-.05em;line-height:1.1}.muted,small{color:#53666b}.hero small{color:#dce8e6}.hero a:not(.button){color:#ffe2c8}.article{max-width:850px;padding-top:48px;padding-bottom:64px}.article h1{font-size:clamp(36px,5vw,58px)}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:12px;border-bottom:1px solid var(--line)}footer{padding:40px 0;background:#e9eeea}a:focus-visible{outline:3px solid #b84d20;outline-offset:4px}@media(max-width:750px){.nav{align-items:flex-start;flex-direction:column;padding-top:12px;padding-bottom:16px;gap:8px}nav{gap:8px 15px}.hero-grid,.grid{grid-template-columns:1fr;gap:20px}.hero{padding:38px 0}.wrap{padding-left:20px;padding-right:20px}}
</style>