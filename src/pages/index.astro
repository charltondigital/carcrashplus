---
import Base from '../layouts/Base.astro';
import data from '../data/arizona.json';
---
<Base title="Crash statistics, research and accident resources"><section class="hero"><div class="wrap hero-grid"><div><div class="eyebrow">Independent road safety information</div><h1>Understanding car crashes.</h1><p>Explore the data behind road accidents, find practical help after a crash and access Arizona-specific legal resources.</p><a class="button" href="/research/">Explore crash data →</a></div><div><div class="eyebrow">Arizona · 2025</div>{data.metrics.slice(0,2).map(m=><div style="padding:18px 0;border-bottom:1px solid #54747b"><div class="stat">{m.value.toLocaleString('en-US')}</div><div>{m.label}</div></div>)}<p><small>Source: <a href={data.url}>ADOT, August 2026</a></small></p></div></div></section><section class="wrap section"><div class="eyebrow">Data & research</div><h2>Arizona crashes, by the numbers</h2><div class="grid">{data.metrics.slice(2,5).map(m=><div class="tile"><div class="stat">{m.value.toLocaleString('en-US')}</div><p>{m.label} in 2025</p></div>)}</div><p><a href="/arizona/crash-statistics/">See the statewide data and sources →</a></p></section><section class="wrap section"><h2>Resources after an accident</h2><div class="grid"><div class="tile"><h3>What to do after a crash</h3><p>Safety, documentation and reporting.</p><a href="/resources/">Read the guide →</a></div><div class="tile"><h3>Arizona resources</h3><p>State-specific crash information and official resources.</p><a href="/arizona/">Explore Arizona →</a></div><div class="tile"><h3>Find legal help</h3><p>Resources for locating an Arizona accident attorney.</p><a href="/attorneys/">Find an attorney →</a></div></div></section></Base>