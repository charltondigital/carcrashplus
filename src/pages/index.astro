---
import Base from '../layouts/Base.astro';
import data from '../data/arizona.json';
const guides=[{title:'What to do after a crash',desc:'Safety, documentation and reporting.',href:'/resources/'},{title:'Arizona resources',desc:'State-specific crash information and official resources.',href:'/arizona/'},{title:'Find legal help',desc:'Resources for locating an Arizona accident attorney.',href:'/attorneys/'}];
---
<Base title="Crash statistics, research and accident resources"><section class="home-hero"><div class="wrap home-hero-grid"><div><h1>Understanding car crashes.</h1><p class="home-lede">Explore the data behind road accidents, find practical help after a crash and access Arizona-specific legal resources.</p><div class="home-actions"><a class="home-button home-button-primary" href="/research/">Explore crash data <span aria-hidden="true">→</span></a><a class="home-button home-button-outline" href="/resources/">After a crash <span aria-hidden="true">→</span></a></div><p class="home-independent">Independent information. Not a government agency.</p></div><aside class="home-quick"><h2>Arizona crash data · 2025</h2>{data.metrics.slice(0,2).map(m=><div class="crash-stat-row"><strong class="stat">{m.value.toLocaleString('en-US')}</strong>{m.label}</div>)}<p class="fineprint">Source: <a href={data.url}>ADOT, August 2026</a></p></aside></div></section><section class="wrap home-section"><div class="home-section-heading"><h2>Arizona crashes, by the numbers</h2><a href="/arizona/crash-statistics/">View statewide data →</a></div><div class="crash-data-grid">{data.metrics.slice(2,5).map(m=><div class="tile"><div class="stat">{m.value.toLocaleString('en-US')}</div><p>{m.label} in 2025</p></div>)}</div></section><section class="wrap home-section"><div class="home-section-heading"><h2>Resources after an accident</h2></div><div class="home-guide-grid">{guides.map(g=><a href={g.href} class="home-guide"><h3>{g.title}</h3><p>{g.desc}</p><span class="home-guide-action">Explore →</span></a>)}</div></section><section class="wrap home-bottom-note"><h2>Independent. Data-driven. Practical.</h2><p>Car Crash Plus organizes crash statistics and accident resources from public agencies and other documented sources.</p><a href="/about/">About Car Crash Plus →</a></section></Base>